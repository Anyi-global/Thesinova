generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Booking {
  id            String        @id @default(cuid())
  name          String
  email         String
  serviceSlug   String
  packageName   String
  meetingDate   DateTime
  meetingTime   String
  details       String
  paymentOption String
  status        String        @default("PENDING")
  createdAt     DateTime      @default(now())
}
